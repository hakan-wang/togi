# Supabase persistence/auth. When both are set, API services use Supabase; otherwise local memory fallback is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Agents SDK. When OPENAI_API_KEY is set, Planner/Reality agents call the SDK; otherwise deterministic local fallback is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Calendar OAuth boundary.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
