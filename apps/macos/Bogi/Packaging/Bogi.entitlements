<?xml version="1.0" encoding="UTF-8"?>
<!-- Bogi is NOT sandboxed (App Sandbox blocks reading other apps' accessibility tree).
     Hardened runtime is enabled at codesign time for notarization. These entitlements
     cover the network client + the APIs Bogi uses. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>            <false/>
    <key>com.apple.security.network.client</key>         <true/>
    <key>com.apple.security.personal-information.calendars</key> <true/>
    <key>com.apple.security.device.audio-input</key>     <true/>
    <!-- Allow Sparkle's updater XPC / DYLD for the hardened runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key> <true/>
</dict>
</plist>
