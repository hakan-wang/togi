# Copy to .env.local and fill in. .env.local is gitignored.

# --- Voice transcription ---
# Use ONE of these. Groq is free + fast (recommended); OpenAI is the paid fallback.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Categorizer: the existing deployed Togi backend (Claude via Bedrock) ---
BACKEND_BASE_URL=https://e7fsq18rqf.execute-api.eu-west-1.amazonaws.com

# --- Supabase (auth + storage of Real entries) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Google Calendar (server-side OAuth: read + edit, multi-user) ---
# See SETUP_GOOGLE_CALENDAR.md for the exact Google Cloud Console steps.
# Client ID is public; the SECRET and ENC KEY are server-only — never prefix them NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to `${origin}/api/google/callback`. Set only if you need to override.
GOOGLE_REDIRECT_URI=
# Any long random string — encrypts stored tokens (AES-GCM) and signs the OAuth state.
# Generate one with:  openssl rand -base64 48
TOKEN_ENC_KEY=
# NOTE: server-side token storage REQUIRES SUPABASE_SERVICE_KEY (above) to be set.

# (Legacy — no longer used by the server flow; kept so the client can optionally
#  detect configuration. Safe to leave blank.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
