# Copy to .env.local and fill in. .env.local is gitignored.

# --- Voice transcription ---
# Use ONE of these. Groq is free + fast (recommended); OpenAI is the paid fallback.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Categorizer: the existing deployed Togi backend (Claude via Bedrock) ---
BACKEND_BASE_URL=https://e7fsq18rqf.execute-api.eu-west-1.amazonaws.com

# --- Supabase (auth + storage of Real entries) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Google Calendar (optional): a public Web OAuth Client ID (no secret needed) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
