{
  "name": "bogi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bogi stateless proxy: Bedrock (Claude Sonnet 4.6) + Supabase paid-status + Stripe webhook. No user data stored.",
  "scripts": {
    "build": "esbuild src/handler.mjs --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0"
  }
}
