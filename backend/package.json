{
  "name": "bogi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless AWS Lambda proxy for Bogi: Bedrock inference, Supabase paid-status, Stripe webhooks. Stores no user data.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@supabase/supabase-js": "^2.45.4",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.7.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
